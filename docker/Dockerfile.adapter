# syntax=docker/dockerfile:1.4

FROM python:3.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

RUN uv pip install --system discord.py websockets

COPY adapters/discord_adapter.py /app/adapters/discord_adapter.py

CMD ["python", "/app/adapters/discord_adapter.py"]
